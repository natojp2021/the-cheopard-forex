# ==============================================================================
# TEMPLATE CẤU HÌNH THE CHEOPARD  - TỆP .ENV.EXAMPLE
# ==============================================================================
# Sao chép tệp này thành .env và điền các thông số tài khoản tương ứng của bạn.

# ------------------------------------------------------------------------------
# 1. THÔNG TIN TÀI KHOẢN METATRADER 5 (MT5 CREDENTIALS)
# ------------------------------------------------------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=your_master_password
MT5_SERVER=Exness-MT5Real
# Đường dẫn terminal — BẮT BUỘC khi máy có NHIỀU bản MT5 (hệ Forex và hệ XAUUSD
# chạy song song). Bỏ trống thì thư viện tự chọn bản nào nó tìm thấy trước, và
# "bản nào" đó không xác định được — tức bot có thể đặt lệnh nhầm tài khoản.
# Dựng bản thứ hai bằng `scripts/setup_second_mt5.ps1`.
# Cho phép gửi lệnh THẬT ra broker. Mặc định 1 = BẬT.
# Đặt 0 để chạy khô: đi hết đường code nhưng không gọi order_send.
LIVE_ORDERS=1

MT5_PATH=C:\Program Files\MetaTrader 5 - Forex\terminal64.exe

# ------------------------------------------------------------------------------
# 0. MÔI TRƯỜNG CHẠY (APP_ENV) — kiểm soát các hành vi chỉ dành cho production
# ------------------------------------------------------------------------------
# PROD = kích hoạt gửi email thật (SMTP) qua mọi module (email_reporter/alerts/
# strategy_report_email). Bất kỳ giá trị nào khác (hoặc để trống, kể cả DEV/DEMO)
# => KHÔNG gửi email thật, chỉ ghi log "[EMAIL SKIPPED - APP_ENV != PROD]" —
# an toàn mặc định khi chạy demo/VPS thử nghiệm, tránh spam hộp thư thật.
APP_ENV=DEV

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH GỬI EMAIL THÔNG BÁO & BÁO CÁO (SMTP EMAIL CONFIG)
# ------------------------------------------------------------------------------
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=true
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASS="your_16_char_app_password"
EMAIL_RECIPIENT=recipient@gmail.com
EMAIL_SENDER_NAME="THE CHEOPARD"
EMAIL_SESSION_END_GMT=16:30
EMAIL_WATCH_POLL_SECONDS=60
EMAIL_ONLY_WHEN_TRADES=true

# Strategy Intelligence cadence (business timezone, independent from VPS timezone)
REPORT_TIMEZONE=Asia/Bangkok
REPORT_TRIGGER_GRACE_MINUTES=10
REPORT_SCHEDULER_POLL_SECONDS=30

# ------------------------------------------------------------------------------
# 3. RISK GUARD — GLOBAL KILL SWITCH (Câu hỏi 39)
# ------------------------------------------------------------------------------
# % drawdown equity (so với equity đầu ngày) để kích hoạt đóng SẠCH mọi vị thế
# + khoá toàn hệ thống (cần can thiệp thủ công mới mở lại). Không đặt = mặc định 25.
KILL_SWITCH_DD_PCT=25.0

# ------------------------------------------------------------------------------
# 4. BOT INFO
# ------------------------------------------------------------------------------
BOT_NAME="THE CHEOPARD"

# ------------------------------------------------------------------------------
# 5. API KEY — Macro/News Sentiment Filter (đã wire vào live 24/07, xem
# core/macro_sentiment_scheduler.py + core/macro_circuit_breaker.py +
# core/portfolio_allocation.py::compute() — macro_multiplier) + AI MoE (Mixture
# of Experts, core/ai_moe_engine.py — Gemini/Groq/OpenRouter/GitHub Models,
# dùng cho cả macro sentiment lẫn AI Position Controller quản lý vị thế)
# ------------------------------------------------------------------------------


# https://finnhub.io — free tier ~60 calls/phút # FINHUB_API_KEYS=key1,key2,key3 (tuỳ chọn) nhiều key — ưu tiên hơn FINHUB_API_KEY nếu có cả 2
FINHUB_API_KEY=your_finnhub_api_key      

# https://newsapi.org — free tier ~100 requests/ngày # NEWS_API_KEYS=key1,key2,key3  (tuỳ chọn) nhiều key
NEWS_API_KEY=your_newsapi_key                

# https://www.alphavantage.co — free tier ~25 requests/ngày (quota rất thấp, nguồn bổ sung)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key  

# https://aistudio.google.com/apikey — dùng SDK google-genai GEMINI_API_KEYS=key1,key2,key3  
GEMINI_API_KEY=your_gemini_api_key


# 3 provider dưới đây dùng cho L1/L2 Chairman cascade của AI MoE
# (core/ai_moe_engine.py) — trước đây KHÔNG có trong file này dù đã dùng
# trong code (gap tài liệu, đã phát hiện khi audit 25/07). Thiếu key nào thì
# provider đó bị bỏ qua trong cascade (fail-soft, không chặn quyết định MoE
# nếu còn ít nhất 1 provider khác khả dụng).
GROQ_API_KEY=your_groq_api_key                 # https://console.groq.com/keys — free tier, model llama-3.3-70b-versatile
# GROQ_API_KEYS=key1,key2,key3                 # (tuỳ chọn) nhiều key

OPEN_ROUTER_API_KEY=your_openrouter_api_key    # https://openrouter.ai/keys — free tier có ngân sách ngày riêng (xem OPENROUTER_DAILY_LIMIT trong ai_moe_engine.py)
# OPEN_ROUTER_API_KEYS=key1,key2,key3          # (tuỳ chọn) nhiều key

GITHUB_API_KEY=your_github_models_token        # https://github.com/marketplace/models — GitHub Models free tier (gpt-4o/gpt-4o-mini)
# GITHUB_API_KEYS=key1,key2,key3               # (tuỳ chọn) nhiều key


# ------------------------------------------------------------------------------
# 6. Tier S — dữ liệu kinh tế CHÍNH THỨC (Market Intelligence Layer, 28/07)
# core/shared/macro/economic_data_fetcher.py — CPI/NFP/thất nghiệp/GDP/lợi suất/
# Fed funds rate lấy TRỰC TIẾP từ cơ quan thống kê, không qua trung gian tin
# tức. KHÔNG có "forecast/consensus" (đó là dịch vụ lịch kinh tế trả phí kiểu
# TradingEconomics, CHƯA có key) — 3 nguồn dưới chỉ có giá trị THỰC TẾ đã công
# bố. Thiếu nguồn nào thì `fetch_economic_snapshot()` bỏ qua nguồn đó, không
# chặn 2 nguồn còn lại (fail-soft từng phần).
# ------------------------------------------------------------------------------

# https://fred.stlouisfed.org/docs/api/api_key.html — miễn phí, đăng ký ngay lập tức. Rate limit 120 req/phút.
FRED_API_KEY=your_fred_api_key
# FRED_API_KEYS=key1,key2,key3                 # (tuỳ chọn) nhiều key

# https://www.bls.gov/developers/ — miễn phí, đăng ký lấy "registrationkey". Registered: tối đa 500 request/ngày, 50 series/request.
BLS_API_KEY=your_bls_api_key
# BLS_API_KEYS=key1,key2,key3                  # (tuỳ chọn) nhiều key

# https://apps.bea.gov/API/signup/ — miễn phí, đăng ký lấy UserID (36 ký tự). Rate limit ~100 request/phút.
BEA_API_KEY=your_bea_api_key
# BEA_API_KEYS=key1,key2,key3                  # (tuỳ chọn) nhiều key

# https://stream.financialjuice.com/ — Tier A, tin breaking real-time qua WebSocket
# (KHÁC kiến trúc polling của các nguồn trên — cần collector riêng dạng thread
# nền giữ kết nối lâu dài, CHƯA triển khai, xem task Market Intelligence Layer
# phần "Tier S/A còn lại"). Key đã có trong .env nhưng CHƯA có code tiêu thụ.
FINANCIALJUICE_API_KEY=your_financialjuice_api_key
# FINANCIALJUICE_API_KEYS=key1,key2,key3       # (tuỳ chọn) nhiều key

# ------------------------------------------------------------------------------
# PHA TÀI KHOẢN — công tắc giữa FTMO Challenge Mode và Fund Trading Mode
# ------------------------------------------------------------------------------
# CHALLENGE (mặc định) | VERIFICATION | FUNDED
#
# Đây là biến QUAN TRỌNG NHẤT trong file này. Nó quyết định hai thứ cùng lúc:
#   1. Hệ số rủi ro: CHALLENGE/VERIFICATION -> k=0,10 (nhanh)
#                    FUNDED                 -> k=0,05 (chắc, một nửa)
#   2. Điều kiện dừng: ở pha thi, đạt +10% (Phase 1) hoặc +5% (Phase 2) thì bot
#      DỪNG giao dịch để chờ FTMO xét duyệt. Ở FUNDED không có đích nên bot chạy
#      liên tục.
#
# KHI FTMO DUYỆT XONG MỘT PHA, BẠN PHẢI ĐỔI BIẾN NÀY RỒI KHỞI ĐỘNG LẠI.
# Nếu không, bot đứng yên vĩnh viễn ở trạng thái "chờ xét duyệt" — nó không có
# cách nào tự biết FTMO đã duyệt (tín hiệu đó đến qua email cho con người, không
# có API). Hệ thống CỐ Ý không tự suy pha từ số dư: đó sẽ là một quy tắc nghiệp
# vụ không có căn cứ.
#
# Ngược lại, để nguyên CHALLENGE trên một tài khoản đã funded làm bot chạy rủi ro
# GẤP ĐÔI mức đã thiết kế cho tài khoản đó.
# FTMO_PHASE=CHALLENGE

# ==============================================================================
# HAI MODE RỦI RO — "mode thi ưu tiên nhanh, mode giao dịch ưu tiên chắc"
# ==============================================================================
# Cỡ lệnh tính theo ĐỆM tới sàn (CPPI), không theo % equity cố định:
#
#     risk_usd = k × min(đệm tổng, đệm ngày)
#     đệm tổng = equity − vốn ban đầu × 90%      (Max Loss — sàn TĨNH)
#     đệm ngày = equity − (balance đầu ngày − 5% × vốn)
#
# `k` là hệ số duy nhất phân biệt hai mode. Risk tự co lại khi equity xuống,
# nên đường vốn tiệm cận sàn thay vì cắt qua.
#
# Đo 03/08 (5.000 đường block-bootstrap trên 5.472 lệnh của 5 chiến lược LIVE,
# chạy đúng công thức trên — xem scratch/ftmo_cppi_two_mode_2026-08-03.py):
#
#     pha thi      k=0,10 -> risk lệnh đầu 0,500%  P(PASS) 99,8%  ~3,2 tháng
#                  k=0,04 -> risk lệnh đầu 0,200%  P(PASS) 100%   ~6,7 tháng
#     pha funded   k=0,05 -> risk lệnh đầu 0,250%  P(mất TK) 0%   lãi p50 13,9%
#
# Vì sao hai mode khác nhau: trượt Challenge = mất phí Challenge; mất tài khoản
# funded = mất cả dòng thu nhập nhiều năm. Hai mất mát lệch nhau hàng bậc độ lớn.
#
# BÌNH THƯỜNG KHÔNG CẦN ĐẶT GÌ Ở ĐÂY — mode tự suy từ `phase` trong state FTMO.
# Chỉ đặt khi muốn ép khác mặc định.

# auto (mặc định) | speed | safe
#   auto  = theo phase: CHALLENGE/VERIFICATION -> nhanh, FUNDED -> chắc
#   speed = luôn dùng hệ số pha thi
#   safe  = luôn dùng hệ số pha funded (đi chậm mà chắc ngay khi đang thi)
# FTMO_RISK_MODE=auto

# Hệ số đệm từng mode. Khoảng hợp lệ (0; 0,50]. Giá trị sai làm hệ thống DỪNG
# NGAY lúc khởi động — cố ý, vì đây là con số quyết định cỡ lệnh thật.
# Trần RISK_ABSOLUTE_MAX (0,5%/lệnh) vẫn luôn được áp sau cùng.
# FTMO_RISK_K_CHALLENGE=0.10
# FTMO_RISK_K_FUNDED=0.05

# ─────────────────────────────────────────────────────────────────────────────
# FTMO — hai biến điều khiển RỦI RO chưa được tài liệu hoá (bổ sung 08/08)
# ─────────────────────────────────────────────────────────────────────────────

# FTMO_INITIAL_BALANCE — vốn ban đầu THẬT của tài khoản, tính bằng USD.
#
# Đây là MẪU SỐ của mọi giới hạn FTMO: hạn mức lỗ ngày = 5% × giá trị này, sàn
# tuyệt đối = 90% × giá trị này. Sai ở đây là sai TẤT CẢ.
#
# Để TRỐNG trong trường hợp bình thường: bot tự chốt từ số dư quan sát ở ngày
# đầu. Chỉ đặt khi bot được gắn vào một tài khoản ĐANG CHẠY DỞ hoặc khi
# `ftmo_state.json` bị mất — lúc đó số dư quan sát KHÔNG phải vốn ban đầu.
#
# Khi không đặt và số dư không khớp cỡ tài khoản chuẩn nào, bot LÀM TRÒN LÊN
# mốc chuẩn gần nhất. Đó là hướng an toàn: ước THẤP đặt sàn dưới vạch chết thật
# và bot sẽ giao dịch xuyên qua nó; ước CAO chỉ khiến bot dừng sớm.
#
# Giá trị sai định dạng làm bot DỪNG lúc khởi động chứ không đoán.
#   FTMO_INITIAL_BALANCE=400000

# MACRO_BLOCK_FULL_DAY — chặn vào lệnh CẢ NGÀY khi có tin tác động mạnh (NFP,
# CPI, FOMC), thay vì chỉ chặn cửa sổ ±30 phút quanh giờ ra tin.
#
#   1 (mặc định) = chặn cả ngày
#   0            = chỉ chặn cửa sổ quanh tin
#
# CÁI GIÁ ĐÃ ĐO: 320 ngày trên 2.240 ngày làm việc = 14,3% số ngày giao dịch bị
# khoá hoàn toàn. Cứ 7 ngày mất 1. Đó là đánh đổi có chủ đích cho mục tiêu qua
# FTMO (không dính cú nhảy giá quanh tin), không phải mặc định "cho an toàn".
MACRO_BLOCK_FULL_DAY=1
